{
  "version": 2,
  "note": "MMTR 车辆动态面 · 面文档键表（v2）。由 MmtrFaceSchema.exportJson() 生成，用例 MmtrFaceSchemaTests 逐字比对 —— 不要手改；缺键时用例会写出 schema.json.actual，拷过来即可。",
  "exportPath": "mmtr/tools/face-studio/schema.json",
  "elementTypes": ["text", "rect", "roundrect", "line", "circle", "arc", "gauge", "image", "foreach"],
  "animKinds": ["blink", "marquee", "fade", "spin"],
  "sections": [
    {"name": "document", "doc": "整块面的键（faces[name] 这一层）", "keys": [{"name": "background", "type": "color", "default": "0", "doc": "整面底色；0 = 不铺底（让模型材质透出来）"}, {"name": "textColor", "type": "color", "default": "#FFF2F4F6", "doc": "文本与 gauge 的缺省颜色"}, {"name": "pxPerMetre", "type": "int", "default": 0, "doc": "像素密度；0 = 用引擎缺省 512"}, {"name": "side", "type": "enum", "default": "normal", "values": ["driver", "normal", "both"], "doc": "画在法线那侧 / 司机那侧 / 两侧"}, {"name": "require", "type": "logic", "default": null, "doc": "整块面的门（不成立就一块都不画）"}, {"name": "vars", "type": "object", "default": {}, "doc": "给条件起名字（值是一条表达式）"}, {"name": "fps", "type": "int", "default": 8, "doc": "动画重画节拍 1..30（没有动画时用不到）"}, {"name": "elements", "type": "elements", "default": [], "doc": "元素表；没写 pages 时它就是第 0 页"}, {"name": "pages", "type": "pages", "default": null, "doc": "多页；写了它就忽略 elements"}, {"name": "pageSeconds", "type": "number", "default": 6, "doc": "自动轮转周期（秒）；0 = 不自动转"}, {"name": "pageExpr", "type": "logic", "default": null, "doc": "指定当前页（数 = 下标，字 = 页名）"}, {"name": "roll", "type": "number", "default": 0, "doc": "整面绕自身法线滚转（度）"}, {"name": "tilt", "type": "number", "default": 0, "doc": "整面绕自身水平轴抬起（度）"}, {"name": "drum", "type": "object", "default": null, "doc": "翻牌机：把各页贴到 N 面棱柱上转"}]},
    {"name": "page", "doc": "一页的键（pages[] 里的一项）", "keys": [{"name": "name", "type": "text", "default": "", "doc": "页名（给 pageExpr 用字名）"}, {"name": "require", "type": "logic", "default": null, "doc": "这一页的门"}, {"name": "elements", "type": "elements", "default": [], "doc": "这一页的元素表"}]},
    {"name": "common", "doc": "每个元素都认的键", "keys": [{"name": "type", "type": "enum", "default": "text", "values": ["text", "rect", "roundrect", "line", "circle", "arc", "gauge", "image", "foreach"], "doc": "元素类型"}, {"name": "when", "type": "logic", "default": null, "doc": "这个元素的显示条件"}, {"name": "x", "type": "number", "default": 0.5, "doc": "水平位置（0..1 牌宽）"}, {"name": "y", "type": "number", "default": 0.5, "doc": "竖直位置（0 = 牌底）"}, {"name": "w", "type": "number", "default": 0, "doc": "宽（0..1 牌宽）"}, {"name": "h", "type": "number", "default": 0, "doc": "高（0..1 牌高）"}, {"name": "size", "type": "number", "default": 0.4, "doc": "字高（0..1 牌高）"}, {"name": "color", "type": "color", "default": "0", "doc": "颜色；0 = 用文档 textColor（只对 text/gauge）"}, {"name": "align", "type": "enum", "default": "center", "values": ["left", "center", "right"], "doc": "文本水平对齐"}, {"name": "text", "type": "template", "default": "", "doc": "文本模板：{字段} / {字段|过滤器}"}, {"name": "rotate", "type": "number", "default": 0, "doc": "绕自身锚点在面内转（度，顺时针为正）"}, {"name": "opacity", "type": "number", "default": 1, "doc": "整元素透明度 0..1"}, {"name": "anim", "type": "object", "default": null, "doc": "逐帧动画（见 anim 段）"}]},
    {"name": "drum", "doc": "翻牌机的键（drum 段）", "keys": [{"name": "count", "type": "int", "default": 2, "doc": "棱柱面数 2..8（第 i 面贴第 i 页）"}, {"name": "turnFraction", "type": "number", "default": 0.25, "doc": "一个周期里用于翻转的比例"}, {"name": "radiusM", "type": "number", "default": 0, "doc": "棱柱外接半径（米）；0 = 正棱柱"}]},
    {"name": "element:text", "doc": "元素 text 的专属键", "keys": [{"name": "shrinkToFit", "type": "number", "default": 0.9, "doc": "超宽等比缩小；0 = 不缩"}]},
    {"name": "element:rect", "doc": "元素 rect 的专属键", "keys": []},
    {"name": "element:roundrect", "doc": "元素 roundrect 的专属键", "keys": [{"name": "radius", "type": "number", "default": 0.08, "doc": "圆角半径（牌高比例）"}]},
    {"name": "element:line", "doc": "元素 line 的专属键", "keys": [{"name": "x2", "type": "number", "default": null, "doc": "终点水平位置（缺省 = 与 x 相同）"}, {"name": "y2", "type": "number", "default": null, "doc": "终点竖直位置（缺省 = 与 y 相同）"}, {"name": "width", "type": "number", "default": 0.03, "doc": "线宽（牌高比例）"}]},
    {"name": "element:circle", "doc": "元素 circle 的专属键", "keys": [{"name": "radius", "type": "number", "default": 0.1, "doc": "半径（牌高比例）"}]},
    {"name": "element:arc", "doc": "元素 arc 的专属键", "keys": [{"name": "radius", "type": "number", "default": 0.4, "doc": "半径（牌高比例）"}, {"name": "start", "type": "number", "default": 0, "doc": "起始角（度，逆时针从 +X 起）"}, {"name": "end", "type": "number", "default": 360, "doc": "结束角"}, {"name": "width", "type": "number", "default": 0.01, "doc": "线宽（牌高比例）"}]},
    {"name": "element:gauge", "doc": "元素 gauge 的专属键", "keys": [{"name": "radius", "type": "number", "default": 0.44, "doc": "表盘半径（牌高比例）"}, {"name": "start", "type": "number", "default": 225, "doc": "刻度起始角"}, {"name": "end", "type": "number", "default": -45, "doc": "刻度结束角"}, {"name": "width", "type": "number", "default": 0, "doc": "表盘线宽（别名 lineWidth）"}, {"name": "lineWidth", "type": "number", "default": 0.004, "doc": "表盘线宽"}, {"name": "max", "type": "number", "default": 160, "doc": "指针满偏对应的值"}, {"name": "ticks", "type": "number", "default": 0, "doc": "刻度格数；0 = 不画刻度"}, {"name": "tickLength", "type": "number", "default": 0.12, "doc": "刻度长度（牌高比例）"}, {"name": "labelEvery", "type": "number", "default": 0, "doc": "每隔几格写数字；0 = 不写"}, {"name": "labelSize", "type": "number", "default": 0.13, "doc": "数字字高（牌高比例）"}, {"name": "labelColor", "type": "color", "default": "0", "doc": "数字颜色；0 = 跟表盘同色"}, {"name": "needle", "type": "logic", "default": null, "doc": "指针值表达式（缺省车速 km/h）"}, {"name": "needleColor", "type": "color", "default": "#FFFF3B30", "doc": "指针颜色"}, {"name": "needleWidth", "type": "number", "default": 0.05, "doc": "指针宽度（牌高比例）"}, {"name": "needleLength", "type": "number", "default": 0.94, "doc": "指针长度（表盘半径比例）"}]},
    {"name": "element:image", "doc": "元素 image 的专属键", "keys": [{"name": "src", "type": "text", "default": "", "doc": "图片标识：mmtr:vehicle/face/x.png"}, {"name": "fit", "type": "enum", "default": "stretch", "values": ["stretch", "contain", "cover"], "doc": "装进 w×h 的方式"}, {"name": "alpha", "type": "number", "default": 1, "doc": "透明度 0..1"}, {"name": "tint", "type": "color", "default": "#FFFFFF", "doc": "色调（乘到像素上）"}]},
    {"name": "element:foreach", "doc": "元素 foreach 的专属键", "keys": [{"name": "var", "type": "text", "default": "", "doc": "数据路径（列表）"}, {"name": "of", "type": "logic", "default": null, "doc": "数据表达式（与 var 二选一）"}, {"name": "as", "type": "text", "default": "item", "doc": "每一项绑到哪个名字"}, {"name": "index", "type": "text", "default": "index", "doc": "下标绑到哪个名字"}, {"name": "limit", "type": "int", "default": 32, "doc": "最多画几项 0..256"}, {"name": "elements", "type": "elements", "default": [], "doc": "每一项要画的元素"}]},
    {"name": "anim:blink", "doc": "动画 blink 的键", "keys": [{"name": "kind", "type": "enum", "default": "blink", "values": ["blink"], "doc": "动画名"}, {"name": "onMs", "type": "number", "default": 600, "doc": "亮多久（毫秒）"}, {"name": "offMs", "type": "number", "default": 600, "doc": "灭多久（毫秒）"}]},
    {"name": "anim:marquee", "doc": "动画 marquee 的键", "keys": [{"name": "kind", "type": "enum", "default": "marquee", "values": ["marquee"], "doc": "动画名"}, {"name": "spanMs", "type": "number", "default": 4000, "doc": "走一趟多久（毫秒）"}, {"name": "direction", "type": "enum", "default": "left", "values": ["left", "right"], "doc": "走向"}, {"name": "gap", "type": "number", "default": 0.3, "doc": "接缝（牌高比例）"}]},
    {"name": "anim:fade", "doc": "动画 fade 的键", "keys": [{"name": "kind", "type": "enum", "default": "fade", "values": ["fade"], "doc": "动画名"}, {"name": "spanMs", "type": "number", "default": 1500, "doc": "一个来回多久（毫秒）"}, {"name": "min", "type": "number", "default": 0.25, "doc": "最暗到多少（0..1）"}]},
    {"name": "anim:spin", "doc": "动画 spin 的键", "keys": [{"name": "kind", "type": "enum", "default": "spin", "values": ["spin"], "doc": "动画名"}, {"name": "spanMs", "type": "number", "default": 2000, "doc": "转一圈多久（毫秒）"}]}
  ]
}
