{
  "version": 1,
  "note": "MMTR 车辆动态面 · 字段表。由 MmtrFaceFields.exportJson() 生成，用例 MmtrFaceFieldsTests 逐字比对 —— 不要手改；缺字段时用例会写出 fields.json.actual，拷过来即可。",
  "fields": [
    { "name": "speed", "type": "num", "kind": "raw", "mirror": "speed", "sync": "tick", "unit": "m/ms", "doc": "当前速度（引擎单位：米/毫秒）—— 要 km/h 用 speedKmh" },
    { "name": "speedKmh", "type": "num", "kind": "derived", "mirror": "", "sync": "na", "unit": "km/h", "doc": "车速度，km/h（= speed × 3600）；排版时用 {speedKmh|int} 取整" },
    { "name": "limitKmh", "type": "num", "kind": "raw", "mirror": "mmtrSpeedLimitKmh", "sync": "tick", "unit": "km/h", "doc": "当前限速；0 = 没有限速信息" },
    { "name": "clock", "type": "str", "kind": "raw", "mirror": "", "sync": "na", "unit": "", "doc": "客户端时钟 HH:MM（不来自引擎，按本机时间画）" },
    { "name": "pid.service", "type": "str", "kind": "raw", "mirror": "mmtrPidService", "sync": "tick", "unit": "", "doc": "班次号（= 作业单号，如 00101）；空 = 这台车不在任何在跑的作业单上" },
    { "name": "pid.terminus", "type": "str", "kind": "raw", "mirror": "mmtrPidTerminus", "sync": "tick", "unit": "", "doc": "本趟终点（到下一次换端为止的最后一个站台停车站）；回库趟为空" },
    { "name": "pid.next", "type": "str", "kind": "raw", "mirror": "mmtrPidNext", "sync": "tick", "unit": "", "doc": "下一站（当前位置之后第一个站台停车站，可跨换端）" },
    { "name": "job.id", "type": "str", "kind": "raw", "mirror": "mmtrJobId", "sync": "tick", "unit": "", "doc": "作业单号" },
    { "name": "job.step", "type": "num", "kind": "raw", "mirror": "mmtrTaskStep", "sync": "tick", "unit": "", "doc": "当前第几步（从 1 起；0 = 不在执行）" },
    { "name": "job.steps", "type": "num", "kind": "raw", "mirror": "mmtrTaskSteps", "sync": "tick", "unit": "", "doc": "这份作业单共几步" },
    { "name": "job.note", "type": "str", "kind": "raw", "mirror": "mmtrTaskNote", "sync": "tick", "unit": "", "doc": "这一步的人话说明" },
    { "name": "mission.state", "type": "str", "kind": "raw", "mirror": "mmtrMissionState", "sync": "tick", "unit": "", "doc": "任务态" },
    { "name": "mission.executor", "type": "str", "kind": "raw", "mirror": "mmtrMissionExecutor", "sync": "tick", "unit": "", "doc": "谁在执行（人 / 自动）" },
    { "name": "subtask.text", "type": "str", "kind": "raw", "mirror": "mmtrSubTasks", "sync": "tick", "unit": "", "doc": "站台作业子任务清单" },
    { "name": "subtask.hint", "type": "str", "kind": "raw", "mirror": "mmtrSubTaskHint", "sync": "tick", "unit": "", "doc": "现在该做什么（站台作业提示）" },
    { "name": "subtask.revision", "type": "num", "kind": "raw", "mirror": "mmtrSubTaskRevision", "sync": "tick", "unit": "", "doc": "子任务版本号（变了 = 清单变了）" },
    { "name": "subtask.acks", "type": "num", "kind": "raw", "mirror": "mmtrSubTaskAcks", "sync": "tick", "unit": "", "doc": "已确认几项" },
    { "name": "hold.reason", "type": "str", "kind": "raw", "mirror": "mmtrHoldReason", "sync": "tick", "unit": "", "doc": "被扣车的理由（空 = 没被扣）—— 调试与乘客提示都用它" },
    { "name": "mode", "type": "str", "kind": "raw", "mirror": "mmtrMode", "sync": "tick", "unit": "", "doc": "车辆模式" },
    { "name": "driver", "type": "str", "kind": "raw", "mirror": "mmtrDriver", "sync": "tick", "unit": "", "doc": "司机名（空 = 无人）" },
    { "name": "active", "type": "bool", "kind": "raw", "mirror": "mmtrActive", "sync": "tick", "unit": "", "doc": "这台车当前是否活跃（有司机/有任务）" },
    { "name": "authorityTripped", "type": "bool", "kind": "raw", "mirror": "mmtrAuthorityTripped", "sync": "snapshot", "unit": "", "doc": "行车许可被触发/切除（整份快照节拍）" },
    { "name": "protection", "type": "bool", "kind": "raw", "mirror": "mmtrProtection", "sync": "tick", "unit": "", "doc": "保护制动中" },
    { "name": "emergency", "type": "bool", "kind": "raw", "mirror": "mmtrEmergency", "sync": "tick", "unit": "", "doc": "紧急制动中" },
    { "name": "pinned", "type": "bool", "kind": "raw", "mirror": "mmtrPinned", "sync": "tick", "unit": "", "doc": "停放钉住（无司机 + 无任务 + 拉不动）" },
    { "name": "light.a", "type": "num", "kind": "raw", "mirror": "mmtrLightA", "sync": "tick", "unit": "", "doc": "A 端灯档（0/1/2）" },
    { "name": "light.b", "type": "num", "kind": "raw", "mirror": "mmtrLightB", "sync": "tick", "unit": "", "doc": "B 端灯档（0/1/2）" },
    { "name": "light.loco", "type": "bool", "kind": "raw", "mirror": "mmtrLightLoco", "sync": "tick", "unit": "", "doc": "本车有没有「关闭」档（机车多一档）" },
    { "name": "aws.warning", "type": "bool", "kind": "raw", "mirror": "mmtrAwsWarningPending", "sync": "tick", "unit": "", "doc": "AWS 报警待确认" },
    { "name": "aws.acknowledged", "type": "bool", "kind": "raw", "mirror": "mmtrAwsWarningAcknowledged", "sync": "tick", "unit": "", "doc": "AWS 报警已确认" },
    { "name": "block.held", "type": "bool", "kind": "raw", "mirror": "mmtrBlockHeld", "sync": "tick", "unit": "", "doc": "被闭塞/进路按住" },
    { "name": "lzb.supervising", "type": "bool", "kind": "raw", "mirror": "mmtrLzbSupervising", "sync": "tick", "unit": "", "doc": "LZB 正在监督" },
    { "name": "lzb.ceilingKmh", "type": "num", "kind": "raw", "mirror": "mmtrLzbCeilingKmh", "sync": "tick", "unit": "km/h", "doc": "LZB 顶棚速度" },
    { "name": "lzb.targetKmh", "type": "num", "kind": "raw", "mirror": "mmtrLzbTargetKmh", "sync": "tick", "unit": "km/h", "doc": "LZB 目标速度" },
    { "name": "lzb.targetM", "type": "num", "kind": "raw", "mirror": "mmtrLzbTargetDistanceM", "sync": "tick", "unit": "m", "doc": "到 LZB 目标的距离" },
    { "name": "shunt.authority", "type": "str", "kind": "raw", "mirror": "mmtrShuntAuthority", "sync": "tick", "unit": "", "doc": "调车授权" },
    { "name": "shunt.limitKmh", "type": "num", "kind": "raw", "mirror": "mmtrShuntSpeedLimitKmh", "sync": "tick", "unit": "km/h", "doc": "调车限速" },
    { "name": "shunt.remainingS", "type": "num", "kind": "raw", "mirror": "mmtrShuntRemainingS", "sync": "tick", "unit": "s", "doc": "调车授权剩余时间" },
    { "name": "handle.throttle", "type": "num", "kind": "raw", "mirror": "mmtrThrottleNotch", "sync": "tick", "unit": "", "doc": "油门手柄位置" },
    { "name": "handle.brake", "type": "num", "kind": "raw", "mirror": "mmtrBrakeNotch", "sync": "tick", "unit": "", "doc": "制动手柄位置" },
    { "name": "handle.reverser", "type": "num", "kind": "raw", "mirror": "mmtrReverser", "sync": "tick", "unit": "", "doc": "换向器（-1/0/1）" },
    { "name": "handle.drive", "type": "num", "kind": "raw", "mirror": "mmtrDriveHandle", "sync": "tick", "unit": "", "doc": "单手柄位置（单手柄车底）" },
    { "name": "handle.cruiseKmh", "type": "num", "kind": "raw", "mirror": "mmtrCruiseKmh", "sync": "tick", "unit": "km/h", "doc": "定速巡航设定值（0 = 没开）" },
    { "name": "handle.spec", "type": "str", "kind": "raw", "mirror": "mmtrHandleSpec", "sync": "tick", "unit": "", "doc": "手柄规格字符串（这车有几个手柄、几档）" },
    { "name": "cab.end", "type": "str", "kind": "raw", "mirror": "mmtrCabEnd", "sync": "tick", "unit": "", "doc": "当前占用哪一端（A/B）" },
    { "name": "cab.carIndex", "type": "num", "kind": "raw", "mirror": "mmtrCabCarIndex", "sync": "tick", "unit": "", "doc": "驾驶室在第几节车" },
    { "name": "cab.arcM", "type": "num", "kind": "raw", "mirror": "mmtrCabArcM", "sync": "tick", "unit": "m", "doc": "驾驶室沿编组的弧长位置" },
    { "name": "cab.keyHolder", "type": "str", "kind": "raw", "mirror": "mmtrCabKeyHolder", "sync": "tick", "unit": "", "doc": "钥匙在谁手里" },
    { "name": "cab.crew", "type": "str", "kind": "raw", "mirror": "mmtrCabCrew", "sync": "tick", "unit": "", "doc": "驾驶室乘务人员" },
    { "name": "cab.active", "type": "str", "kind": "raw", "mirror": "mmtrActiveCab", "sync": "tick", "unit": "", "doc": "哪一端是活动驾驶室" },
    { "name": "cab.name", "type": "str", "kind": "raw", "mirror": "mmtrCabName", "sync": "snapshot", "unit": "", "doc": "驾驶室名字（整份快照节拍）" },
    { "name": "motor.forceN", "type": "num", "kind": "raw", "mirror": "mmtrMotorForceN", "sync": "tick", "unit": "N", "doc": "电机出力" },
    { "name": "brake.pneumaticForceN", "type": "num", "kind": "raw", "mirror": "mmtrPneumaticBrakeForceN", "sync": "tick", "unit": "N", "doc": "整列气制动力" }
  ]
}
