# Build output of the anchor-check fixtures. Regenerate with:
#   node mmtr/tools/obj-mtr-packager/pack_vehicle.js mmtr/tools/anchor-check/fixture/foldfix.json
#   node mmtr/tools/obj-mtr-packager/pack_vehicle.js mmtr/tools/anchor-check/fixture/wipefix.json
#
# Each fixture needs its OWN staging directory: the packager wipes the staging dir it is given
# (fs.rmSync), so two fixtures sharing one would delete each other's anchor file.
out/
stage/
stage-wipefix/
