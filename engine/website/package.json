{
	"name": "mmtr-console",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --noEmit && vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"test:plan": "node --experimental-strip-types --test scripts/plan-time.test.ts",
		"test:map-nodes": "node --experimental-strip-types --test scripts/map-nodes.test.ts",
		"test:total-sections": "node --experimental-strip-types --test scripts/total-sections.test.ts",
		"test:rail-frame": "node --experimental-strip-types --test scripts/rail-frame.test.ts",
		"test:platforms": "node --experimental-strip-types --test scripts/platforms.test.ts",
		"test:vehicles": "node --experimental-strip-types --test scripts/vehicles.test.ts",
		"test:vehicle-shapes": "node --experimental-strip-types --test scripts/vehicle-shapes.test.ts",
		"test:vehicle-hit": "node --experimental-strip-types --test scripts/vehicle-hit.test.ts",
		"test:mission-target": "node --experimental-strip-types --test scripts/mission-target.test.ts",
		"test:map-actions": "node --experimental-strip-types --test scripts/map-actions.test.ts",
		"test:api-client": "node --experimental-strip-types --test scripts/api-client.test.ts",
		"test": "npm run test:plan && npm run test:map-nodes && npm run test:total-sections && npm run test:rail-frame && npm run test:platforms && npm run test:vehicles && npm run test:vehicle-shapes && npm run test:vehicle-hit && npm run test:mission-target && npm run test:map-actions && npm run test:api-client"
	},
	"dependencies": {
		"naive-ui": "^2.42.0",
		"svg-pan-zoom": "^3.6.2",
		"vue": "^3.5.13"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@types/node": "^22.20.2",
		"@vitejs/plugin-vue": "^6.0.1",
		"eslint": "^9.39.1",
		"eslint-plugin-vue": "^10.5.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.0",
		"vite": "^7.1.12",
		"vue-tsc": "^3.1.1"
	}
}
