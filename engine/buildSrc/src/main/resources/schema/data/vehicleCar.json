{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"javaImplements": [
		"SerializedDataBase"
	],
	"properties": {
		"vehicleId": {
			"type": "string"
		},
		"length": {
			"type": "number",
			"minimum": 0
		},
		"width": {
			"type": "number",
			"minimum": 0
		},
		"capacity": {
			"type": "integer",
			"minimum": 1
		},
		"bogie1Position": {
			"type": "number"
		},
		"bogie2Position": {
			"type": "number"
		},
		"couplingPadding1": {
			"type": "number",
			"minimum": 0
		},
		"couplingPadding2": {
			"type": "number",
			"minimum": 0
		},
		"mmtrPowered": {
			"type": "boolean",
			"default": true
		},
		"mmtrLoadRatio": {
			"type": "number",
			"default": 0,
			"minimum": 0,
			"maximum": 1
		},
		"mmtrConsistTypeId": {
			"type": "string",
			"default": ""
		},
		"mmtrCouplerAfter": {
			"type": "boolean",
			"default": false
		},
		"mmtrAutoCoupler": {
			"type": "boolean",
			"default": true
		}
	},
	"required": [
		"vehicleId",
		"length",
		"width",
		"capacity",
		"bogie1Position",
		"bogie2Position",
		"couplingPadding1",
		"couplingPadding2"
	]
}
